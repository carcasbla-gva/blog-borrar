{# Reusable pagination navigation. #}
{% set ventana = ventana|default(2) %}
{% set parametros = parametros|default({}) %}

{% if totalPages is defined and totalPages > 1 %}
    {% set desde = max(1, page - ventana) %}
    {% set hasta = min(totalPages, page + ventana) %}

    <nav class="pager" aria-label="Paginación de posts">
        <ul class="pagination">
            {% if page > 1 %}
                <li class="pager-step">
                    <a href="{{ path(ruta, parametros|merge({'page': page - 1})) }}" rel="prev" aria-label="Página anterior">
                        <i class="fa fa-arrow-left"></i><span class="pager-label">Anterior</span>
                    </a>
                </li>
            {% else %}
                <li class="pager-step disabled"><span aria-disabled="true">Anterior</span></li>
            {% endif %}

            {% if desde > 1 %}
                <li><a href="{{ path(ruta, parametros|merge({'page': 1})) }}" aria-label="Página 1">1</a></li>
                {% if desde > 2 %}<li class="pager-gap" aria-hidden="true"><span>&hellip;</span></li>{% endif %}
            {% endif %}

            {% for i in desde..hasta %}
                {% if i == page %}
                    <li class="active"><span aria-current="page">{{ i }}</span></li>
                {% else %}
                    <li><a href="{{ path(ruta, parametros|merge({'page': i})) }}" aria-label="Página {{ i }}">{{ i }}</a></li>
                {% endif %}
            {% endfor %}

            {% if hasta < totalPages %}
                {% if hasta < totalPages - 1 %}<li class="pager-gap" aria-hidden="true"><span>&hellip;</span></li>{% endif %}
                <li><a href="{{ path(ruta, parametros|merge({'page': totalPages})) }}" aria-label="Página {{ totalPages }}">{{ totalPages }}</a></li>
            {% endif %}

            {% if page < totalPages %}
                <li class="pager-step pager-next">
                    <a href="{{ path(ruta, parametros|merge({'page': page + 1})) }}" rel="next" aria-label="Página siguiente">
                        <span class="pager-label">Siguiente</span><i class="fa fa-arrow-right"></i>
                    </a>
                </li>
            {% else %}
                <li class="pager-step pager-next disabled"><span aria-disabled="true">Siguiente</span></li>
            {% endif %}
        </ul>
        <p class="pager-status">Página {{ page }} de {{ totalPages }}</p>
    </nav>
{% endif %}
