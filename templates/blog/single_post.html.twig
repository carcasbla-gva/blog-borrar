{% extends 'base.html.twig' %}
{% block title %}Single Post{% endblock %}
{% block body %}
    <!-- Principal Content Start -->
    <div id="single">
        <div class="container">
            <!-- Full Article -->
            {% if not post %}
                <div class="row">
                    <div class="col-xs-12">
                        <h2>Post not found</h2>
                    </div>
                </div>
            {% else %}
                <div class="row">
                    <h2>{{ post.title }}</h2>
                    <hr class="subtitle">
                    <div class="block1">
                        <div class="col-xs-12 col-sm-9">
                            <img class="img-responsive" src="{{ asset('images/blog/' ~ post.image) }}" alt="{{ post.title }}">
                            <br>
                            <p>{{ post.content }}</p>
                            <h4>- By {{ post.postUser.name }}</h4>
                            <hr>
                            <ul class="list-inline">
                                <li>{{ post.publishedAt|date('d') }} {{ post.publishedAt|date('F') }} |</li>
                                <li><a class="page-scroll" href="#form">COMMENT</a> <i class="fa fa-comments sr-icons"></i> {{ post.numComments }} |</li>
                                <li><a href="{{ path('post_like', {slug: post.slug}) }}">LIKE</a> <i class="fa fa-heart sr-icons"></i><span id="likes"> {{ post.numLikes }}</span></li>
                            </ul>
                        </div>
                        <div class="col-xs-12 col-sm-3">
                            <h4>Recent Post</h4>
                            <hr class="subtitle1">
                            {% for recent in recents %}
                                {{ include('partials/_recent_post.html.twig', {'recent': recent}) }}
                            {% endfor %}
                        </div>
                    </div>
                </div>
                <!-- End of Full Article -->
            {% endif %}

            <!-- Comments -->
            <div class="row">
                <div class="col-xs-12 col-sm-12 block2">
                    {% for comment in post.comments %}
                        <div class="comment">
                            <h4>{{ comment.name }}</h4>
                            <p class="time">{{ comment.publishedAt|date('g:i A') }}</p>
                            <hr>
                            <p>{{ comment.text }}</p>
                        </div>
                    {% endfor %}

                    <hr class="line">
                    <div id="form" class="col-xs-12 col-sm-6 col-sm-push-3">
                        {{ form_start(form) }}
                        <div class="form-group">
                            <div class="col-xs-12 col-sm-6">
                                {{ form_row(form.name) }}
                            </div>
                            <div class="col-xs-12 col-sm-6">
                                {{ form_row(form.email) }}
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-xs-12">
                                {{ form_row(form.text) }}
                                {{ form_row(form.Send) }}
                            </div>
                        </div>
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
            <!-- End of Comments -->
        </div>
    </div>
    <!-- End of Principal Content Start -->
    {% if post %}
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const likeLink = document.querySelector('a[href="{{ path('post_like', {slug: post.slug}) }}"]');
                const likesSpan = document.querySelector('#likes');
                likeLink.addEventListener('click', function (event) {
                    event.preventDefault();
                    fetch(likeLink.href, {
                        method: 'POST',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest',
                            'Content-Type': 'application/json'
                        }
                    })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                likesSpan.innerHTML = " " + data.likes;
                            }
                        })
                        .catch(error => console.error('Error:', error));
                });
            });
        </script>
    {% endif %}
{% endblock %}
